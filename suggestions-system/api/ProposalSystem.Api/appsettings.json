{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/proposals.db",
    "SqlServer": "Server=localhost\\SQLEXPRESS;Database=ProposalSystem;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Security": {
    "Session": {
      "CookieName": "__Host-sci_session",
      "CsrfCookieName": "XSRF-TOKEN",
      "CsrfHeaderName": "X-XSRF-TOKEN",
      "IdleTimeoutHours": 8,
      "AbsoluteLifetimeHours": 24,
      "TouchIntervalSeconds": 60,
      "MaxFailedLogins": 5,
      "LockoutMinutes": 15
    },
    "Cors": {
      "AllowedOrigins": [ "https://suggestions.shjcharity.ae" ],
      "PreflightMaxAgeMinutes": 10
    },
    "Hsts": {
      "MaxAgeDays": 365,
      "IncludeSubDomains": true,
      "Preload": false
    },
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 5
    },
    "BehindReverseProxy": false,
    "KnownProxies": []
  },

  "BlindReview": {
    "RevealStage": "CommitteeApproval",
    "AdminSeesIdentityBeforeReveal": false,
    "HideDepartmentBeforeReveal": false
  },

  "Sla": {
    "CheckIntervalMinutes": 15,
    "ScreeningHours": 72,
    "CommitteeHours": 240,
    "ExecutiveHours": 120,
    "ReturnedForEditHours": 336,
    "ReminderRepeatHours": 24,
    "Escalation": {
      "Enabled": true,
      "Level1AfterHours": 48,
      "Level2AfterHours": 96,
      "RerouteScreeningToManager": true,
      "FallbackUserCode": null
    }
  },

  "ImpactTracking": {
    "WindowOpensAfterMonths": 3,
    "DueAfterMonths": 6
  },

  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFiles": 10,
    "MaxFileBytes": 10485760,
    "MaxTotalBytes": 15728640
  },

  "SeedDemoData": false
}
