{
  // Arabic: Modern Standard, Gulf dialect, and Arabizi (Arabic in Latin letters and digits).
  // Patterns are normalized exactly like patient text (CrisisTextNormalizer): أ/إ/آ → ا, ة → ه, ى → ي,
  // diacritics and hamza dropped, repeated letters collapsed, Arabizi digits mapped (3→a, 7→h, 5→kh, 8→gh, 9→q, 2→∅).
  // Grammar: "a|b" alternatives, "a_b" consecutive words, "x*" prefix, "x?" optional, "..." up to 3 words.
  // Clinical owner: the clinical lead. Changes need their approval and a green evaluation run.
  "language": "ar",
  "version": "ar-2026.10.1",
  "rules": [
    {
      "id": "AR-C-INTENT",
      "level": "Critical",
      "category": "suicidal_intent",
      "patterns": [
        "سانتحر|بنتحر|راح_انتحر|رح_انتحر|ح_انتحر",
        "ناوي|ناويه|قررت|مقرر|مقرره|عازم|عازمه ... انتحر*|انتحار|اموت|بموت|اقتل_نفسي|انهي_حياتي",
        "ابي|ابغى|ابغي|اريد|ودي|بدي|ناوي|ناويه|قررت اقتل|اذبح|انهي|اخلص|احرق|اشنق نفسي|حياتي|عمري",
        "بقتل|ساقتل|راح_اقتل|رح_اقتل نفسي",
        "بنهي|سانهي|راح_انهي|انهي حياتي|عمري"
      ],
      "examples": [
        "سأنتحر",
        "والله بنتحر",
        "قررت أنتحر خلاص",
        "أبي أقتل نفسي",
        "بقتل نفسي الليلة",
        "ناوية أموت",
        "رح أنهي حياتي",
        "ابغى انهي حياتي"
      ],
      "counterExamples": [
        "قررت أنهي الواجب اليوم",
        "ابي اخلص الشغل"
      ]
    },
    {
      "id": "AR-C-TIMELINE",
      "level": "Critical",
      "category": "timeline",
      "patterns": [
        "الليله|اليوم|بكره|بكرا|الحين|هالليله ... اموت|بموت|انتحر*|بنتحر|اقتل_نفسي|بقتل_نفسي|انهي_حياتي",
        "اموت|بموت|انتحر*|بنتحر|انهي_حياتي ... الليله|اليوم|بكره|بكرا|الحين|هالليله"
      ],
      "examples": [
        "الليلة أنتحر",
        "اليوم بموت ما عاد أتحمل",
        "بكرا بنتحر",
        "أموت الليلة"
      ],
      "counterExamples": [
        "اليوم ذاكرت كثير",
        "الحين أنهي الواجب بعدين أنام",
        "اليوم شفت فيلم عن الحرب"
      ]
    },
    {
      "id": "AR-C-MEANS",
      "level": "Critical",
      "category": "means_access",
      "patterns": [
        "جمعت|خبيت|شريت|اشتريت|حضرت|جهزت|عندي ... حبوب|ادويه|حبل|سكين|موس|شفره|مسدس|سلاح ... اموت|بموت|انتحر*|بنتحر|انهي_حياتي",
        "جمعت|خبيت|حضرت|جهزت حبوب|ادويه|حبل|السم|سم",
        "باخذ|بشرب|ساخذ|ساشرب|راح_اخذ|راح_اشرب ... حبوب|الحبوب|العلبه|الدواء|الادويه ... كل*|كامل*",
        "حبل ... رقبتي",
        "انط|بنط|اطيح|بطيح من|م فوق? السطح|الدور|الجسر|الشباك|البلكونه|العماره|الكبري",
        "ارمي|برمي|سارمي نفسي"
      ],
      "examples": [
        "جمعت حبوب كثير",
        "عندي حبل وبنتحر",
        "بشرب الحبوب كلها",
        "بنط من السطح",
        "ارمي نفسي من الدور"
      ],
      "counterExamples": [
        "عندي حبوب الضغط",
        "أخذت حبة بنادول"
      ]
    },
    {
      "id": "AR-C-OVERDOSE",
      "level": "Critical",
      "category": "overdose_acute",
      "patterns": [
        "بلعت|شربت|اخذت|خذيت ... حبوب|العلبه|علبه|شريط|الدواء ... كل*|كامل*|كثير|كثيره|كلهم",
        "بلعت|شربت سم|كلور|فلاش"
      ],
      "examples": [
        "بلعت العلبة كلها",
        "أخذت حبوب كثيرة قبل شوي",
        "شربت كلور"
      ],
      "counterExamples": [
        "أخذت الدواء بموعده"
      ]
    },
    {
      "id": "AR-C-SELFHARM-ACUTE",
      "level": "Critical",
      "category": "self_harm_acute",
      "patterns": [
        "جرحت|قطعت|شرحت يدي|ايدي|معصمي|عروقي|نفسي",
        "انزف|ينزف|نزيف ... يدي|ايدي|كثير|ما_يوقف"
      ],
      "exceptions": [
        "جرحت|قطعت يدي|ايدي ... اطبخ|بالغلط|المطبخ|بالسكين_وانا"
      ],
      "examples": [
        "جرحت يدي الحين",
        "قطعت عروقي",
        "أنزف كثير"
      ],
      "counterExamples": [
        "جرحت يدي وأنا أطبخ"
      ]
    },
    {
      "id": "AR-C-GOODBYE",
      "level": "Critical",
      "category": "farewell",
