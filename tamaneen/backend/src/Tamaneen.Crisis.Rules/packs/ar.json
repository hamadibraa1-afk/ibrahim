        "اقتل|بقتل الوقت|الملل|الفراغ"
      ],
      "examples": [
        "والله بقتله",
        "ناوي أقتل أبوي",
        "راح أأذي عيالي",
        "بطعن زوجي"
      ],
      "counterExamples": [
        "بقتله من الضحك هالولد",
        "أبي أقتل الوقت"
      ]
    },
    {
      "id": "AR-H-IDEATION",
      "level": "High",
      "category": "suicidal_ideation",
      "patterns": [
        "ابي|ابغى|ابغي|اريد|ودي|بدي|اتمنى|تمنيت|نفسي|امنيتي اموت|الموت|اختفي",
        "ابي|ابغى|ودي|اريد انام ... ما|ولا اصحى|اقوم|اصحي",
        "ما|مو|ماعاد ابي|ابغى|اريد|ودي|قادر|قادره اعيش|اكمل|استمر",
        "مابي|مابغى|ماعاد_ابي اعيش|اكمل",
        "انتحار|انتحر|الانتحار",
        "افكر|افكر_في|افكر_ب|يجيني|تجيني ... الموت|اموت|اذي_نفسي",
        "الموت|موتي ارحم|احسن|افضل",
        "ليتني|ياليتني|يا_ليتني|ليت ميت|ميته|ما_انولدت|اموت",
        "تعبت|طفشت|زهقت|مليت من|م الحياه|حياتي|العيش|الدنيا|نفسي",
        "ابي|ابغى|ودي ارتاح من|م الدنيا|الحياه"
      ],
      "exceptions": [
        "اموت فيك|عليك|فيه|عليه|فيها|عليها|فيهم|فيكم",
        "اموت|بموت من|م ضحك|الضحك|الجوع|الحر|البرد|الملل|الشوق|الفرح|الحب",
        "اموت ضحك|جوع|برد|حر|ملل|شوق",
        "تعبت|طفشت|زهقت|مليت من|م الشغل|الدراسه|المذاكره|الدوام|الزحمه",
        "اكمل الواجب|الدراسه|الشغل|الجلسه|المحادثه|الاكل|الفيلم"
      ],
      "examples": [
        "ابي اموت",
        "أتمنى الموت",
        "ودي أنام وما أصحى",
        "ما أبي أعيش",
        "مابي اكمل",
        "أفكر في الانتحار",
        "الموت أرحم",
        "ليتني ميت",
        "تعبت من الحياة",
        "ابي ارتاح من الدنيا",
        "وأبي أموت",
        "أبي أموت من التعب"
      ],
      "counterExamples": [
        "أموت فيك",
        "بموت من الضحك",
        "أموت من الجوع",
        "تعبت من الدوام",
        "مليت من المذاكرة",
        "ما أبي أكمل الواجب"
      ]
    },
    {
      "id": "AR-H-BURDEN",
      "level": "High",
      "category": "hopelessness_burden",
      "patterns": [
        "عبء|عبئ|حمل|ثقل على|علي اهلي|الكل|الناس|عيلتي|عايلتي|اسرتي|الجميع",
