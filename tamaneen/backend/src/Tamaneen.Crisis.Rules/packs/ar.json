        "وداعًا للأبد",
        "ودعت أهلي"
      ]
    },
    {
      "id": "AR-C-HARM-OTHERS",
      "level": "Critical",
      "category": "harm_to_others",
      "patterns": [
        "بقتله|بقتلها|بقتلهم|ساقتله|ساقتلها|اقتله|اقتلها|اقتلهم|بذبحه|بذبحها|بذبحهم",
        "راح|ابي|ابغى|ناوي|قررت اقتل|اذبح|اطعن|اذي ... ابوي|امي|زوجي|زوجتي|اخوي|اختي|ولدي|بنتي|مديري|اطفالي|عيالي|الكل|احد",
        "باذي|بطعن|راح_اذي ... احد|ابوي|امي|زوجي|زوجتي|اخوي|اختي|عيالي|اطفالي"
