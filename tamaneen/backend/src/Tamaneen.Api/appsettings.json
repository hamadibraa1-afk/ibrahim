{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "AlwaysEncrypted": false,
    "CommandTimeoutSeconds": 30
  },
  "Encryption": {
    "Provider": "AzureKeyVault",
    "KeyVaultKeyId": "",
    "DataKeyCacheSeconds": 300
  },
  "Pseudonymization": {
    "ContactPepperBase64": ""
  },
  "Auth": {
    "Issuer": "https://auth.tamaneen.app",
    "Audience": "tamaneen-api"
  },
  "Cors": {
    "Origins": [ "https://app.tamaneen.app", "https://staff.tamaneen.app" ]
  }
}
