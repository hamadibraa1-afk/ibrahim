{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "AlwaysEncrypted": false,
    "CommandTimeoutSeconds": 15
  },
  "Encryption": {
    "Provider": "AzureKeyVault",
    "KeyVaultKeyId": "",
    "DataKeyCacheSeconds": 300
  },
  "Pseudonymization": {
    "ContactPepperBase64": ""
  },
  "Auth": {
    "Issuer": "https://auth.tamaneen.app",
    "Audience": "tamaneen-api",
    "ServerKeyBase64": ""
  },
  "Crisis": {
    "Sla": {
      "CriticalAcknowledgeSeconds": 120,
      "CriticalContactSeconds": 300,
      "HighAcknowledgeSeconds": 900,
      "HighContactSeconds": 3600,
      "MaxEscalationTier": 2
    },
    "Contacts": {
      "EmergencyNumber": "",
      "SupportLine": ""
    },
    "Worker": {
      "ServiceUserId": "",
      "ServiceKeyBase64": "",
      "EscalationIntervalSeconds": 15,
      "PagingIntervalSeconds": 5,
      "RunBackgroundLoops": true,
      "ConsoleBaseUrl": "https://staff.tamaneen.app"
    },
    "Paging": {
      "WebhookUrl": "",
      "WebhookSecretBase64": "",
      "TimeoutSeconds": 10
    }
  },
  "Cors": {
    "Origins": [
      "https://staff.tamaneen.app"
    ]
  }
}
