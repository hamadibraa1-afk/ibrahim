<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Crisis.Worker runs as its own process so that an API outage or a slow language model never stops
    crisis detection, escalation or paging. It owns the crisis console's live hub.
  -->
  <PropertyGroup>
    <RootNamespace>Tamaneen.Crisis.Worker</RootNamespace>
    <UserSecretsId>tamaneen-crisis-worker-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tamaneen.Infrastructure\Tamaneen.Infrastructure.csproj" />
    <ProjectReference Include="..\Tamaneen.Hosting\Tamaneen.Hosting.csproj" />
    <ProjectReference Include="..\Tamaneen.Crisis.Rules\Tamaneen.Crisis.Rules.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tamaneen.IntegrationTests" />
  </ItemGroup>
</Project>
